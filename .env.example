# PostgreSQL connection string from Supabase (use SSL).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# The app listens on PORT when deployed (Render sets it automatically).
APP_ENV=development
APP_PORT=8080

# Local development defaults are admin/admin123 and manager/manager123.
# Always replace these with strong secrets before a production deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
MANAGER_USERNAME=manager
MANAGER_PASSWORD=replace-with-another-long-unique-password

# Supabase Storage: create a PUBLIC bucket named product-images.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-secret
SUPABASE_STORAGE_BUCKET=product-images
